{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/beat-road/index.html" },
    { "source": "/:path((?!beat-road/).*)", "destination": "/beat-road/:path" }
  ],
  "headers": [
    { "source": "/(.*)\\.mp3", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
